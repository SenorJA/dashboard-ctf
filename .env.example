# ════════════════════════════════════════════════════════════════
#  M.I.R.V. — Environment configuration
#  Copy this file to `.env` and fill in your credentials.
#  All variables are OPTIONAL — the app has graceful defaults
#  (offline-first, in-memory) until you configure them.
# ════════════════════════════════════════════════════════════════

# ────────────────────────────────────────────────────────────────
# 1) Supabase — backend persistence (free tier)
#    https://supabase.com/dashboard/project/<your-project>/settings/api
#    Without these, data (connections, reports, findings, missions...)
#    is lost on restart (in-memory / offline-first).
# ────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ...
# Optional: direct-postgres password + management token (auto-create tables)
SUPABASE_DB_PASSWORD=
SUPABASE_MGMT_TOKEN=
# Optional: Supabase Storage bucket name (default: "vulnforge")
STORAGE_BUCKET=vulnforge

# ────────────────────────────────────────────────────────────────
# 2) Kali Linux over SSH — terminal, arsenal & tool workflows
#    Defaults: 192.168.214.142 / user:javi / pass:javi / port 22
#    Tip: use the Terminal → Connections tab in the UI instead of env.
# ────────────────────────────────────────────────────────────────
KALI_IP=192.168.214.142
KALI_USER=javi
KALI_PASS=javi
KALI_PORT=22
# Optional: host for the kali-mcp Docker integration
KALI_MCP_URL=

# ────────────────────────────────────────────────────────────────
# 3) LLM — default provider for AI chat & multi-agent orchestrator
#    "local" → Ollama at http://localhost:11434  (free, no API key)
#    Or use the free tiers of Groq/Gemini/OpenRouter (UI: AI Settings)
#    The Op Admiral tab also lets you override these PER SPECIALIST.
# ────────────────────────────────────────────────────────────────
MIRV_AI_PROVIDER=local
MIRV_AI_KEY=
MIRV_AI_MODEL=llama3.2
# Optional: Ollama endpoint (default: http://localhost:11434)
OLLAMA_URL=http://localhost:11434

# ────────────────────────────────────────────────────────────────
# 4) OSINT — optional bearer token for /api/osint/* endpoints
#    Generate any random string:  openssl rand -hex 16
#    If empty, endpoints work with rate-limit but no auth.
# ────────────────────────────────────────────────────────────────
MIRV_OSINT_TOKEN=
# Optional: Instagram OSINT via IG_SESSIONID (browser session cookie)
IG_SESSIONID=

# ────────────────────────────────────────────────────────────────
# 5) Burp Bridge — optional shared token for POST /api/burp/ingest
#    Set the same value in the Jython plugin (backend/burp_plugin/).
# ────────────────────────────────────────────────────────────────
MIRV_BURP_TOKEN=

# ────────────────────────────────────────────────────────────────
# 6) Secret Store — at-rest encryption key for app_credentials
#    OPTIONAL. Either a raw Fernet key (32-byte urlsafe-base64) or any
#    passphrase (derived via scrypt). If empty, a key is generated once
#    at backend/data/enc_secret.key (0600, gitignored).
#    KEEP IT SAFE: losing it makes stored secrets unrecoverable.
#    Generate a fresh key with:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ────────────────────────────────────────────────────────────────
MIRV_ENC_KEY=

# ────────────────────────────────────────────────────────────────
# 7) Server — port (default: 8000)
# ────────────────────────────────────────────────────────────────
PORT=8000