# Python
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
dist/
build/

# Env
.env
.env.local
*.env
.env.*

# Node / pnpm
node_modules/
package-lock.json

# OS
.DS_Store
Thumbs.db
nul

# IDE
.vscode/
.idea/
*.swp
*.swo

# Runtime data (episodic memory, etc.)
backend/data/*
# Curated prompt library is shipped with the app (data, no secrets)
!backend/data/prompts/
backend/data/prompts/prompts.csv
backend/data/*.db
backend/data/*.db-journal
backend/data/*.db-wal
# Secret-store encryption key (Fernet) — NEVER commit
backend/data/enc_secret.key
# API token file (MIRV_API_TOKEN_FILE default) — NEVER commit
backend/data/api_token.txt

# Logs
*.log
backend/logs/

# Temp files / editor backups
C:*
c:*
/tmp/
*.bak
*.orig
*.rej

# Playwright / test artifacts
playwright-report/
test-results/

# Coverage
.coverage
htmlcov/
coverage.xml
backend/logs/*.log

# Tauri updater signing key (PRIVATE — never commit)
desktop/.tauri/
# Tauri updater config injected by CI only on releases (never commit)
desktop/src-tauri/tauri.updater.json
# Tauri build output (regenerated by tauri-build)
desktop/src-tauri/gen/
