{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the main MIRV window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "process:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/mirv-backend",
          "sidecar": true
        }
      ]
    }
  ]
}